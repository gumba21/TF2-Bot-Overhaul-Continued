	modify:
	{
		match:
		{
			"origin" "912 1440 320"
			"filtername" "filter_red_team"
			"classname"  "trigger_multiple"
		}
		insert:
		{
			"OnEndTouchAll" "soldier_generator_1*,Enable,,0,-1"
			"OnEndTouchAll" "Blu_Heavy_generator*,Enable,,0,-1"
			//"OnEndTouchAll" "tf2theme1,PlaySound,,1,-1"
		}
	}
	{
		match:
		{
			"targetname" "flag_red"
		}
		insert:
		{
			"flag_model" "models/empty.mdl"
			"parentname" "flag_blue"
			"OnPickup" "!self,ForceDrop,,1,-1"
			"OnPickup" "!self,ForceReset,,2,-1"
		}
		replace:
		{
			"origin" "489.005 -3348.51 -131.106"
		}
	}
	{
		match:
		{
			"targetname" "capturezone_blue"
		}
		replace:
		{
			"StartDisabled" "1"
		}
	}
	{
		match:
		{
			"targetname" "flag_blue"
		}
		insert:
		{
			// Add little goal descriptions using the old text stuff u used for ur version of tr_target
			"OnPickup" "soldier_generator_2*,Enable,,0,-1"
			"OnPickup" "flag_message1,display,0,-1"
			"OnPickup"  "server_command,Command,tf_bot_add 1 blue,1,1"
			"OnPickup"  "tf2theme2,PlaySound,,1,-1"
			//"OnCapture" "MISSION,Complete,,1,-1" // Doing this will crash the game when trying to load a save. It doesn't really do much beyond adding an icon so this is fine.
			"OnCapture" "MISSION2,Unlock,,2,-1"
			"OnCapture" "MISSION,Save,,1,-1"
		}
	}